GRAPH_DB_URI=bolt://localhost:7687
# Memgraph's community build (what this project runs everywhere) doesn't
# enforce authentication -- these two are only set because common/db.py's
# driver call always passes an auth tuple. There's no real credential here.
GRAPH_DB_USER=memgraph
GRAPH_DB_PASSWORD=unused

# Required for nl_query/ask.py (build order step 5) — your own key
ANTHROPIC_API_KEY=

# Only needed if the key above is an org-level key not scoped to one
# workspace -- the API then rejects every request with "This API key is
# not scoped to a workspace..." until this header is set to the target
# workspace's id (found in the Anthropic Console under that workspace).
# Leave unset if your key is already workspace-scoped; most are.
# ANTHROPIC_WORKSPACE_ID=

# Required by api/app.py — signs the login session cookie. Generate a real
# one per deploy with: python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse the value below (or any value committed to source control) —
# anyone who has it can forge a valid login cookie for this app.
SESSION_SECRET=

# Cookies are Secure (HTTPS-only) by default, which is correct for every
# real deploy target (Render, HF Spaces both terminate TLS in front of the
# app) but breaks login on local dev over plain http://localhost — the
# browser silently drops a Secure cookie sent over http, so login appears
# to "not work." Uncomment for local dev only; never set this in a real
# deploy's environment.
# COOKIE_SECURE=false
