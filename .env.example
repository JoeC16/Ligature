GRAPH_DB_URI=bolt://localhost:7687
# Memgraph's community build (what this project runs everywhere) doesn't
# enforce authentication -- these two are only set because common/db.py's
# driver call always passes an auth tuple. There's no real credential here.
GRAPH_DB_USER=memgraph
GRAPH_DB_PASSWORD=unused

# Required for nl_query/ask.py (build order step 5) — your own key
ANTHROPIC_API_KEY=
